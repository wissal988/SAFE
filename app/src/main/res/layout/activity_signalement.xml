<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F8FA">

    <!-- TOP BAR STYLE SAFE -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/orange_primary"
        android:paddingHorizontal="16dp"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/appName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="SAFE"
            android:textColor="@android:color/black"
            android:textSize="28sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- CONTENU NORMAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:layout_above="@id/bottomBar"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#F6F8FA"
        android:padding="20dp">

        <!-- BOUTON LISTE SIGNALEMENTS -->
        <LinearLayout
            android:id="@+id/btnVoirSignalements"
            android:background="@drawable/rounded_button_orange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="15dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="15dp">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:text="🛑 Liste des signalements"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#000"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content" />

                <TextView
                    android:text="Consultez l’état et le suivi de vos signalements"
                    android:textSize="14sp"
                    android:textColor="#666"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content" />
            </LinearLayout>


        </LinearLayout>

        <!-- BOUTON LISTE RÉCLAMATIONS -->
        <LinearLayout
            android:id="@+id/btnListeReclamations"
            android:background="@drawable/rounded_button_orange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="15dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="15dp">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:text="💡 Liste des réclamations"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#000"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content" />

                <TextView
                    android:text="Consultez l’état et le suivi de vos réclamations"
                    android:textSize="14sp"
                    android:textColor="#666"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content" />
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                />
        </LinearLayout>

        <!-- BOUTON LISTE PROPOSITIONS -->
        <LinearLayout
            android:id="@+id/btnListePropositions"
            android:background="@drawable/rounded_button_orange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="15dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="30dp">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:text="📝 Liste des propositions"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#000"
                    android:layout_height="wrap_content"  android:layout_width="wrap_content"/>

                <TextView
                    android:text="Consultez l’état et le suivi de vos propositions"
                    android:textSize="14sp"
                    android:textColor="#666"
                    android:layout_height="wrap_content"  android:layout_width="wrap_content"/>
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                />
        </LinearLayout>

    </LinearLayout>

    <!-- BOTTOM BAR -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/orange_primary"
        android:weightSum="3"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_alignParentBottom="true">

        <LinearLayout
            android:id="@+id/navBtnProfil"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_compte"
                app:tint="#222222" />

            <TextView
                android:text="Profil"
                android:textColor="#222222"
                android:textSize="12sp"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navBtnAccueil"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_accueil"
                app:tint="#222222" />

            <TextView
                android:text="Accueil"
                android:textColor="#222222"
                android:textSize="12sp"
                android:layout_height="wrap_content"  android:layout_width="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navBtnDeconnexion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_deconnexion"
                app:tint="#222222" />

            <TextView
                android:text="Déconnexion"
                android:textColor="#222222"
                android:textSize="12sp"
                android:layout_width="wrap_content"  android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
