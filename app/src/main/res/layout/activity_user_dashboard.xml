<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/orange_light">

    <!-- ===================== -->
    <!--  LOGO EN ARRIÈRE-PLAN -->
    <!-- ===================== -->
    <ImageView
        android:id="@+id/safelogo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/safelogo"
        android:alpha="0.12"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:contentDescription="Logo en arrière-plan"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===================== -->
    <!--  EFFET FLOU / HALO -->
    <!-- ===================== -->
    <View
        android:id="@+id/blurcircle"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:background="@drawable/blur_circle"
        android:alpha="0.18"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===================== -->
    <!--  TOP BAR -->
    <!-- ===================== -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@color/orange_primary"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/appName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="SAFE"
            android:textColor="@android:color/black"
            android:textSize="28sp"
            android:textStyle="bold"/>
    </RelativeLayout>

    <!-- ===================== -->
    <!--  SCROLL VIEW -->
    <!-- ===================== -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp">

            <!-- Logo principal -->


            <!-- Bonjour -->
            <TextView
                android:id="@+id/greetingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Bonjour --- !"
                android:textStyle="bold"
                android:textColor="#000"
                android:textSize="16sp"/>

            <!-- Question -->
            <TextView
                android:id="@+id/questionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Que voulez-vous faire aujourd’hui ?"
                android:textColor="#000"
                android:textSize="15sp"/>
            <!-- BUTTON 1 -->
            <LinearLayout
                android:id="@+id/btnDanger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:padding="15dp"
                android:gravity="center_vertical"
                android:background="@drawable/rounded_button_orange"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚨 Signaler un danger"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#000"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Signalez un danger immédiatement"
                        android:textSize="14sp"
                        android:textColor="#666"/>
                </LinearLayout>
            </LinearLayout>

            <!-- BUTTON 2 -->
            <LinearLayout
                android:id="@+id/btnAmelioration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:padding="15dp"
                android:gravity="center_vertical"
                android:background="@drawable/rounded_button_orange"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💡 Proposer une amélioration"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#000"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Proposez une amélioration pour l'application"
                        android:textSize="14sp"
                        android:textColor="#666"/>
                </LinearLayout>
            </LinearLayout>

            <!-- BUTTON 3 -->
            <LinearLayout
                android:id="@+id/btnReclamation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:padding="15dp"
                android:gravity="center_vertical"
                android:background="@drawable/rounded_button_orange"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📝 Déposer une réclamation"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#000"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Consultez et déposez vos réclamations"
                        android:textSize="14sp"
                        android:textColor="#666"/>
                </LinearLayout>
            </LinearLayout>

            <!-- BUTTON 4 -->
            <LinearLayout
                android:id="@+id/btnMesSignalements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:padding="15dp"
                android:gravity="center_vertical"
                android:background="@drawable/rounded_button_orange"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📋 Mes signalements"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#000"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Consultez l’état et le suivi de vos signalements"
                        android:textSize="14sp"
                        android:textColor="#666"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ===================== -->
    <!--  BOTTOM BAR -->
    <!-- ===================== -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/orange_primary"
        android:weightSum="3"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Profil -->
        <LinearLayout
            android:id="@+id/navBtnProfil"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_compte"
                app:tint="#222222"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profil"
                android:textSize="12sp"
                android:textColor="#222222"/>
        </LinearLayout>

        <!-- Accueil -->
        <LinearLayout
            android:id="@+id/navBtnAccueil"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_accueil"
                app:tint="#222222"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Accueil"
                android:textColor="#222222"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Déconnexion -->
        <LinearLayout
            android:id="@+id/navBtnDeconnexion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_deconnexion"
                app:tint="#222222"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Déconnexion"
                android:textColor="#222222"
                android:textSize="12sp"/>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>